{
  "info": {
    "name": "MoodLocationFinder API",
    "_postman_id": "mood-location-finder-collection",
    "description": "Collection for testing Backend API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["/"] }
      }
    },
    {
      "name": "Sign Up",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"gender\": \"not-specified\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/signup", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","signup"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","login"] }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "url": { "raw": "http://localhost:5000/api/profile/:id", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","profile",":id"], "variable": [{ "key": "id", "value": "<USER_ID>" }] }
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"gender\": \"male\",\n  \"profileImage\": \"https://example.com/img.png\"\n}" },
        "url": { "raw": "http://localhost:5000/api/profile/:id", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","profile",":id"], "variable": [{ "key": "id", "value": "<USER_ID>" }] }
      }
    },
    {
      "name": "Create History",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"<USER_ID>\",\n  \"locationId\": \"loc123\",\n  \"name\": \"Green Forest\",\n  \"type\": \"forest\",\n  \"date\": \"2026-02-20\",\n  \"time\": \"10:00\"\n}" },
        "url": { "raw": "http://localhost:5000/api/history", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","history"] }
      }
    },
    {
      "name": "Get History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "url": { "raw": "http://localhost:5000/api/history/:userId", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","history",":userId"], "variable": [{ "key": "userId", "value": "<USER_ID>" }] }
      }
    },
    {
      "name": "Promote to Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requesterEmail\": \"admin@example.com\",\n  \"requesterPassword\": \"adminpassword\",\n  \"targetUserId\": \"<TARGET_USER_ID>\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/promote", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","promote"] }
      }
    },
    {
      "name": "Add Favorite",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"<USER_ID>\",\n  \"locationId\": \"loc123\",\n  \"name\": \"Green Forest\",\n  \"type\": \"forest\",\n  \"description\": \"Beautiful forest with fresh air\",\n  \"image\": \"https://example.com/forest.jpg\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/favorite", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","favorite"] }
      }
    },
    {
      "name": "Get Favorites",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "url": { "raw": "http://localhost:5000/api/favorite/:userId", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","favorite",":userId"], "variable": [{ "key": "userId", "value": "<USER_ID>" }] }
      }
    },
    {
      "name": "Remove Favorite",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "url": { "raw": "http://localhost:5000/api/favorite/:favoriteId", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","favorite",":favoriteId"], "variable": [{ "key": "favoriteId", "value": "<FAVORITE_ID>" }] }
      }
    },
    {
      "name": "Check if Favorite",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <TOKEN>" }],
        "url": { "raw": "http://localhost:5000/api/favorite/check?userId=<USER_ID>&locationId=loc123", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api","favorite","check"], "query": [{ "key": "userId", "value": "<USER_ID>" }, { "key": "locationId", "value": "loc123" }] }
      }
    }
  ]
}
